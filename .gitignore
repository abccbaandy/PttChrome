node_modules
**/*.concat.*

# Yarn v4（node-modules linker；cache 走全域）
.yarn/*
!.yarn/patches
.pnp.*

# yarn 專案，勿用 npm
package-lock.json
# 例外：proxy/ 下是與 app 完全獨立的 Cloudflare Worker 專案（自己的 package.json，
# 不進 yarn workspace），用 npm 管理，lock 檔要入 repo 以鎖定 wrangler 版本。
!proxy/**/package-lock.json
# wrangler dev（含 --remote）的本機暫存
.wrangler/

# Playwright E2E
test-results/
playwright-report/
tests/e2e/__screenshots__/
# live e2e 每輪的 DebugRecorder 錄製檔（已 redact，但仍屬個人連線紀錄，不入 repo）
tests/e2e/__recordings__/
# 录制 cassette 用的 PTT 凭证（绝不入 repo）
tests/e2e/.ptt-creds.json

# Firebase emulator（yarn test:integration）
firebase-debug.log
firestore-debug.log
ui-debug.log

js/constants_local.js
dist/*
!dist/.gitkeep

.idea/
3rd_script/

# Claude Code 建的 git worktree（多 session 並行；規則見 CLAUDE.md「多 session 並行」）
.claude/worktrees/
.claude/settings.local.json
# 個人裝置的研究筆記與原始量測（含裝置／已安裝 App 等隱私資訊，絕不入 repo）
docs/local/

# Vitest Browser Mode（unit-browser）的附件／截圖目錄
.vitest/
