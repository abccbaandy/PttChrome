rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user may only read/write their own prefs document.
    // `readLater`＝稍後閱讀（src/js/read_later_sync.js）：一個 map，活的最多 50 篇＋刪除墓碑最多 300 筆
    // （READ_LATER_LIMIT／READ_LATER_TOMBSTONE_LIMIT），這裡擋 400。
    // `saved`（P70，舊版的本機收藏清單）：新版已不讀寫，舊版 App 仍可能寫 ⇒ 照舊擋 300 篇。
    // 擋掉不是 map、或塞爆的寫入（文件上限 1MB，偏好同步每次都會帶到它）。
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && savedListOk() && readLaterOk();
    }

    function savedListOk() {
      return request.resource == null
        || !('saved' in request.resource.data)
        || (request.resource.data.saved is map && request.resource.data.saved.size() <= 300);
    }

    function readLaterOk() {
      return request.resource == null
        || !('readLater' in request.resource.data)
        || (request.resource.data.readLater is map && request.resource.data.readLater.size() <= 400);
    }
  }
}
