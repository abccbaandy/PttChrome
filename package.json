{
  "name": "pttchrome",
  "version": "1.2.0",
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "base58": "^1.0.1",
    "bootstrap": "^5.0.0",
    "classnames": "^2.2.5",
    "firebase": "^12.14.0",
    "hammerjs": "^2.0.8",
    "jquery": "^3.2.1",
    "react": "^16.2.0",
    "react-bootstrap": "^0.31.5",
    "react-dom": "^16.2.0",
    "react-overlays": "^0.7.4",
    "recompose": "^0.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/plugin-proposal-object-rest-spread": "^7.8.3",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.8.7",
    "@babel/preset-react": "^7.8.3",
    "@playwright/test": "^1.49.0",
    "babel-jest": "^29",
    "babel-loader": "^10.0.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "cross-env": "^7.0.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "firebase-tools": "^15.20.0",
    "html-webpack-harddisk-plugin": "^2.0.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^4.2.3",
    "jest": "^29",
    "jest-environment-jsdom": "29",
    "lint-staged": "^10.0.8",
    "mini-css-extract-plugin": "^2.9.0",
    "prettier": "^1.19.1",
    "react-test-renderer": "^16.2.0",
    "rimraf": "^3.0.2",
    "webpack": "^5.107.0",
    "webpack-cdn-plugin": "^3.3.1",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.5"
  },
  "lint-staged": {
    "*.json": [
      "prettier --write",
      "git add"
    ],
    "src/components/**/*.{js,json,css}": [
      "prettier --write",
      "git add"
    ]
  },
  "babel": {
    "env": {
      "development": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "modules": false
            }
          ],
          [
            "@babel/preset-react"
          ]
        ],
        "plugins": [
          "@babel/syntax-dynamic-import",
          "@babel/plugin-proposal-class-properties",
          "@babel/plugin-proposal-object-rest-spread"
        ]
      },
      "production": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "modules": false
            }
          ],
          [
            "@babel/preset-react"
          ]
        ],
        "plugins": [
          "@babel/syntax-dynamic-import",
          "@babel/plugin-proposal-class-properties",
          "@babel/plugin-proposal-object-rest-spread"
        ]
      },
      "test": {
        "presets": [
          "@babel/preset-env",
          "@babel/preset-react"
        ],
        "plugins": [
          "@babel/syntax-dynamic-import",
          "babel-plugin-dynamic-import-node",
          "@babel/plugin-proposal-class-properties",
          "@babel/plugin-proposal-object-rest-spread"
        ]
      }
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "scripts": {
    "clean": "rimraf dist/assets dist/index.html",
    "prebuild": "npm run clean",
    "build": "cross-env webpack",
    "prestart": "npm run clean",
    "start": "cross-env NODE_ENV=development webpack serve",
    "test:unit": "jest",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-pttchrome \"jest -c jest.integration.config.js\"",
    "kill:dev": "node scripts/kill-dev-server.js",
    "test:e2e": "yarn kill:dev && playwright test --project=live",
    "test:e2e:offline": "yarn kill:dev && playwright test --project=offline",
    "test:e2e:headed": "yarn kill:dev && playwright test --project=live --headed",
    "test:e2e:ui": "yarn kill:dev && playwright test --ui",
    "record:cassette": "yarn kill:dev && cross-env RECORD_CASSETTE=1 playwright test --project=record"
  }
}
