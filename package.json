{
  "name": "pttchrome",
  "version": "1.2.0",
  "packageManager": "yarn@4.17.0",
  "dependencies": {
    "@mantine/core": "^9",
    "@mantine/hooks": "^9",
    "classnames": "^2.5.1",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.1.0",
    "husky": "^9.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.json": "prettier --write",
    "src/components/**/*.{js,jsx,json,css}": "prettier --write",
    "src/render/**/*.js": "prettier --write"
  },
  "scripts": {
    "prepare": "husky",
    "build": "vite build",
    "start": "vite",
    "test:unit": "vitest run --project unit",
    "test:integration": "node scripts/run-integration.mjs",
    "kill:dev": "node scripts/kill-dev-server.js",
    "ci:status": "node scripts/ci-status.mjs",
    "test:e2e": "yarn kill:dev && playwright test --project=live",
    "test:e2e:offline": "yarn kill:dev && playwright test --project=offline --project=offline-firefox",
    "test:e2e:offline:firefox": "yarn kill:dev && playwright test --project=offline-firefox",
    "test:e2e:offline:adverse": "yarn kill:dev && node scripts/run-adverse-e2e.mjs",
    "test:e2e:headed": "yarn kill:dev && playwright test --project=live --headed",
    "test:e2e:ui": "yarn kill:dev && playwright test --ui",
    "record:cassette": "yarn kill:dev && RECORD_CASSETTE=1 playwright test --project=record"
  }
}
