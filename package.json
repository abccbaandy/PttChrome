{
  "name": "pttchrome",
  "version": "1.2.0",
  "packageManager": "yarn@4.17.0",
  "dependencies": {
    "@mantine/core": "^9",
    "@mantine/hooks": "^9",
    "classnames": "^2.5.1",
    "firebase": "^12.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "husky": "^9.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.0.0",
    "postcss": "^8.5.19",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.json": "prettier --write",
    "src/components/**/*.{js,jsx,json,css}": "prettier --write"
  },
  "scripts": {
    "prepare": "husky",
    "build": "vite build",
    "start": "vite",
    "test:unit": "vitest run --project unit",
    "test:integration": "node scripts/run-integration.mjs",
    "kill:dev": "node scripts/kill-dev-server.js",
    "test:e2e": "yarn kill:dev && playwright test --project=live",
    "test:e2e:offline": "yarn kill:dev && playwright test --project=offline",
    "test:e2e:headed": "yarn kill:dev && playwright test --project=live --headed",
    "test:e2e:ui": "yarn kill:dev && playwright test --ui",
    "record:cassette": "yarn kill:dev && RECORD_CASSETTE=1 playwright test --project=record"
  }
}
