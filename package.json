{
  "name": "pttchrome",
  "version": "1.2.0",
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@mantine/core": "^9",
    "@mantine/hooks": "^9",
    "base58": "^1.0.1",
    "classnames": "^2.2.5",
    "firebase": "^12.14.0",
    "hammerjs": "^2.0.8",
    "jquery": "^3.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23",
    "@babel/plugin-proposal-object-rest-spread": "^7.8.3",
    "@babel/plugin-transform-class-properties": "^7.27",
    "@babel/preset-env": "^7.29",
    "@babel/preset-react": "^7.8.3",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "babel-jest": "^29",
    "babel-loader": "^10.0.0",
    "cross-env": "^7.0.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-webpack-harddisk-plugin": "^2.0.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.0.0",
    "jest": "^29",
    "jest-environment-jsdom": "29",
    "lint-staged": "^15.0.0",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.0.0",
    "rimraf": "^3.0.2",
    "webpack": "^5.107.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.5"
  },
  "resolutions": {
    "form-data": "^4.0.6",
    "qs": "^6.5.3",
    "json-schema": "^0.4.0",
    "minimatch": "^3.1.2",
    "node-fetch": "^2.6.7",
    "uuid": "^11.1.1",
    "js-yaml": "^4.2.0"
  },
  "lint-staged": {
    "*.json": "prettier --write",
    "src/components/**/*.{js,json,css}": "prettier --write"
  },
  "browserslist": [
    "Chrome >= 90",
    "Edge >= 90",
    "Firefox >= 90",
    "Safari >= 15"
  ],
  "babel": {
    "env": {
      "development": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "modules": false
            }
          ],
          [
            "@babel/preset-react",
            {
              "runtime": "automatic"
            }
          ]
        ],
        "plugins": [
          "@babel/plugin-transform-class-properties",
          "@babel/plugin-proposal-object-rest-spread"
        ]
      },
      "production": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "modules": false
            }
          ],
          [
            "@babel/preset-react",
            {
              "runtime": "automatic"
            }
          ]
        ],
        "plugins": [
          "@babel/plugin-transform-class-properties",
          "@babel/plugin-proposal-object-rest-spread"
        ]
      },
      "test": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "targets": {
                "node": "current"
              }
            }
          ],
          [
            "@babel/preset-react",
            {
              "runtime": "automatic"
            }
          ]
        ],
        "plugins": [
          "@babel/plugin-transform-class-properties",
          "@babel/plugin-proposal-object-rest-spread"
        ]
      }
    }
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf dist/assets dist/index.html",
    "prebuild": "npm run clean",
    "build": "cross-env webpack",
    "prestart": "npm run clean",
    "start": "cross-env NODE_ENV=development webpack serve",
    "test:unit": "jest",
    "test:integration": "node scripts/run-integration.mjs",
    "kill:dev": "node scripts/kill-dev-server.js",
    "test:e2e": "yarn kill:dev && playwright test --project=live",
    "test:e2e:offline": "yarn kill:dev && playwright test --project=offline",
    "test:e2e:headed": "yarn kill:dev && playwright test --project=live --headed",
    "test:e2e:ui": "yarn kill:dev && playwright test --ui",
    "record:cassette": "yarn kill:dev && cross-env RECORD_CASSETTE=1 playwright test --project=record"
  }
}
